{
  "appId": "md0.editor",
  "productName": "md0",
  "directories": { "output": "dist" },
  "files": ["out/**/*", "package.json", "LICENSE"],
  "asar": true,
  "extraResources": [
    { "from": "LICENSE", "to": "LICENSE.md0.txt" },
    { "from": "out/THIRD_PARTY_NOTICES.txt", "to": "THIRD_PARTY_NOTICES.txt" },
    { "from": "assets/fonts/LICENSE.md", "to": "FONT_LICENSE.md" }
  ],
  "win": {
    "target": [{ "target": "nsis", "arch": ["x64"] }],
    "icon": "assets/icons/md0.ico",
    "artifactName": "md0-Setup-${version}.${ext}"
  },
  "nsis": {
    "oneClick": true,
    "perMachine": false,
    "allowElevation": false,
    "createDesktopShortcut": false,
    "createStartMenuShortcut": true,
    "runAfterFinish": false
  },
  "fileAssociations": [
    {
      "ext": ["md", "markdown", "mdown"],
      "name": "md0.Markdown",
      "description": "Markdown document",
      "role": "Editor",
      "icon": "assets/icons/md0.ico"
    }
  ]
}
